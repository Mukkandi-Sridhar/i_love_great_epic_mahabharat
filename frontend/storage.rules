rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Admin status comes from /admins/{uid} only, which no client can write.
    // Never derive it from /users/{uid}: users can edit their own profile, so a
    // `role` field there would let any customer grant themselves upload rights.
    function isAdmin() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    
    // Media files (images, banners)
    match /media/{allPaths=**} {
      allow read: if true; // Public read
      allow write: if isAdmin(); // Only admins can upload
    }
    
    // Ebook files: readable by admins and by users holding a purchase, which
    // the backend writes to /users/{uid}/purchases/{productId}.
    match /files/ebooks/{productId}/{allPaths=**} {
      allow read: if isAdmin() || (request.auth != null &&
                    firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/purchases/$(productId)));
      allow write: if isAdmin();
    }
  }
}
