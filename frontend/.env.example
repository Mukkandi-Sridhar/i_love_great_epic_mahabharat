# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Backend API base URL.
VITE_BACKEND_URL=http://localhost:8000

# ── Firebase (current data backend) ─────────────────────────────────────────
# These are the Firebase *web* config values. They are designed to be public
# and are safe in the client bundle; access is controlled by Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Supabase (migration target) ─────────────────────────────────────────────
# The anon/publishable key is safe to ship: it is subject to Row Level
# Security. The service-role key is server-side only and must NEVER be set
# here — anything VITE_-prefixed is compiled into the public bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Payments ────────────────────────────────────────────────────────────────
# Razorpay key *id* only. The key secret lives on the backend.
VITE_RAZORPAY_KEY_ID=

# Enables the test-payment button. Leave unset in production; the backend
# gates the bypass independently and will reject it outside dev.
VITE_ENABLE_PAYMENT_BYPASS=
