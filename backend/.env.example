OPENAI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_CREDENTIALS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_PAYMENT_BYPASS=false
APP_ENV=production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
CHROMA_DIR=./storage/chroma
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Supabase ────────────────────────────────────────────────────────────────
# Set DATA_BACKEND=supabase to serve from Postgres instead of Firestore.
DATA_BACKEND=firebase
SUPABASE_URL=
# Service-role key: bypasses Row Level Security. Server-side only — never
# expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Project JWT secret, used to verify user access tokens.
SUPABASE_JWT_SECRET=
